GOOGLE_API_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""
BRAINTRUST_API_KEY=""
BRAINTRUST_PROJECT_ID="<your-braintrust-project-id>"
BRAINTRUST_PROJECT="<your-braintrust-project>"
BRAINTRUST_ORG_NAME="<your-braintrust-org-name>"
MODAL_APP_NAME="<your-modal-app-name>"
TRACE_PROFILE="full"
BRAINTRUST_USE_GATEWAY="false"
BRAINTRUST_GATEWAY_URL="https://gateway.braintrust.dev/v1"
BRAINTRUST_GATEWAY_API_KEY=""

# Semantic similarity cache (opt-in)
# Set CACHE_ENABLED=true to activate.  Requires GOOGLE_API_KEY for embeddings.
# Queries are embedded with text-embedding-004 and matched by cosine similarity.
# Math answers are cached for 24 h; research answers for 1 h.
CACHE_ENABLED="false"
CACHE_PATH=".cache/query_cache.json"
CACHE_SIMILARITY_THRESHOLD="0.92"
CACHE_MATH_TTL="86400"
CACHE_RESEARCH_TTL="3600"
